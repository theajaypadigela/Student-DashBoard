<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Attendance - Admin</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/sidebar.css">
    <link rel="stylesheet" href="/admin/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <%- include("sidebar.ejs") %>

    <nav class="head">
        <div class="lefticon">
            <a class="LINK1" href="#">Admin</a>
        </div>
        <div class="righticon">
            <a href="#">
                <img width="50" src="/assets/Screenshot 2025-02-23 171952.png" alt="Profile">
            </a>
        </div>
    </nav>

    <div class="main">
        <div class="page-title-wrap">
            <h1 class="hd-1">MANAGE ATTENDANCE</h1>
            <div class="underline"></div>
        </div>

        <div class="form-card">
            <h2 class="form-heading"><i class="fa fa-clipboard-list"></i> Update student attendance</h2>

            <form action="/admin/add-attendance" method="POST">
                <div class="form-group">
                    <label for="user_id">Select Student</label>
                    <select id="user_id" name="user_id" required>
                        <option value="">-- Select a Student --</option>
                        <% users.forEach(user => { %>
                            <option value="<%= user._id %>"><%= user.name %> (<%= user.email %>)</option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="subject_id">Select Subject</label>
                    <select id="subject_id" name="subject_id" required>
                        <option value="">-- Select a Subject --</option>
                        <% subjects.forEach(subject => { %>
                            <option value="<%= subject._id %>"><%= subject.subject_name %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="present">Present Days</label>
                        <input type="number" id="present" name="present" min="0" value="0" required>
                    </div>

                    <div class="form-group">
                        <label for="absent">Absent Days</label>
                        <input type="number" id="absent" name="absent" min="0" value="0" required>
                    </div>
                </div>

                <button type="submit" class="submit-btn">
                    Update Attendance <span class="arrow">➜</span>
                </button>
            </form>
        </div>
    </div>
</body>

</html>
