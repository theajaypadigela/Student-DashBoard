<!DOCTYPE html>
<html lang="en">
<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni Network</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/alumni/alumni.css">
    <link rel="stylesheet" href="/sidebar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

</head>
<body>
    <div class="container-fluid container-1">
        <div class="element">
            <div class="col-12 mb-4 align-items-center">
                <h1 class="hd-1">Alumni Network</h1>
                <div class="underline"></div>
            </div>
            <%- include("sidebar.ejs") %>
            <div class="container-2 mt-5">
                <div class="row">
                    <!-- Card 1 -->
                     <% for(let i=0;i<aluminiData.length;i++){ 
                        const alumni = aluminiData[i];
                        const imageSrc = alumni.img_url || "/assets/alumini/placeholder.svg";
                        const position = alumni.position || alumni.title || "Alumni";
                        const company = alumni.company || "";
                        const linkedinUrl = alumni.linkedin || alumni.linkedin_url || "";
                        const emailValue = alumni.email || alumni.gmail || alumni.gmail_url || "";
                        let mailtoUrl = "";
                        if (emailValue) {
                            if (emailValue.startsWith("mailto:") || emailValue.startsWith("http")) {
                                mailtoUrl = emailValue;
                            } else {
                                mailtoUrl = `mailto:${emailValue}`;
                            }
                        }
                     %>
                    <div class="col-lg-3 col-md-4 col-sm-6 mt-5 mb-5">
                        <div class="card-1">
                            <div class="img-container">
                                <img src="<%= imageSrc %>" alt="<%= alumni.name %>" class="img-fluid" onerror="this.src='/assets/alumini/placeholder.svg'">
                            </div>
                            <h1 class="hd-2" class="hd-2" style="white-space: normal; overflow-wrap: break-word;"><%= alumni.name %></h1>
                            <p class="pg-1"><%= position %></p>
                            <% if (company) { %>
                            <p class="pg-1"><%= company %></p>
                            <% } %>
                            <ul class="profile-icons">
                                <% if (linkedinUrl) { %>
                                <li>
                                    <a href="<%= linkedinUrl %>" target="_blank" rel="noopener noreferrer"><img src="https://beneficent-dashboard.onrender.com/alumni/linkedin.svg"></a>
                                </li>
                                <% } %>
                                <% if (mailtoUrl) { %>
                                <li>
                                    <a href="<%= mailtoUrl %>"><img src="https://beneficent-dashboard.onrender.com/alumni/gmail.svg"></a>
                                </li>
                                <% } %>
                            </ul>
                        </div>
                    </div>

                    <% } %>
                    

                   

                </div>
            </div>
        </div>
    </div>
</body>
</html>
