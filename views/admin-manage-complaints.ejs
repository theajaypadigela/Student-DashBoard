<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Complaints - Admin</title>
    <link href="https://fonts.googleapis.com/css?family=Poppins:600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/sidebar.css">
    <link rel="stylesheet" href="/admin/admin.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <%- include("sidebar.ejs") %>

    <nav class="head">
        <div class="lefticon">
            <a class="LINK1" href="#">Admin</a>
        </div>
        <div class="righticon">
            <a href="#">
                <img width="50" src="/assets/Screenshot 2025-02-23 171952.png" alt="Profile">
            </a>
        </div>
    </nav>

    <div class="main">
        <div class="page-title-wrap">
            <h1 class="hd-1">MANAGE COMPLAINTS</h1>
            <div class="underline"></div>
        </div>

        <% if (complaints.length === 0) { %>
            <div class="empty-state">
                <i class="fa fa-inbox"></i>
                No complaints found
            </div>
        <% } else { %>
            <% complaints.forEach(complaint => { %>
                <div class="details complaint-card">
                    <div class="top-row">
                        <span class="choose"><%= complaint.requestType %></span>
                        <span class="status-badge status-<%= complaint.status == 0 ? 'pending' : 'resolved' %>">
                            <%= complaint.status == 0 ? 'INITIATED' : 'RESOLVED' %>
                        </span>
                    </div>
                    <p class="title"><%= complaint.title %></p>
                    <p class="descrip"><%= complaint.description %></p>
                    <div class="bottom-row">
                        <span class="date">
                            <i class="fa fa-calendar"></i>
                            <%= new Date(complaint.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                        </span>
                        <form action="/admin/resolve-complaint/<%= complaint._id %>" method="POST" class="action-form">
                            <select name="status" class="action-select">
                                <option value="0" <%= complaint.status == 0 ? 'selected' : '' %>>Initiated</option>
                                <option value="1" <%= complaint.status == 1 ? 'selected' : '' %>>Resolved</option>
                            </select>
                            <button type="submit" class="action-btn danger">Update</button>
                        </form>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</body>

</html>
